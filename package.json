{
  "name": "@tastic/input",
  "version": "0.4.1",
  "description": "Pure, worklet-safe input resolvers for local-multiplayer arcade games: swipe/vector-to-direction classification, keyboard scheme mapping, drag aim vectors (pull/push), flick-throw velocity and tilt math, plus a useTilt device-motion hook in the ./tilt subpath",
  "keywords": [
    "react-native",
    "expo",
    "input",
    "gesture",
    "keyboard",
    "swipe",
    "vec2",
    "tilt",
    "device-motion",
    "accelerometer"
  ],
  "homepage": "https://github.com/jayrdeaton/react-native-game-input#readme",
  "bugs": {
    "url": "https://github.com/jayrdeaton/react-native-game-input/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrdeaton/react-native-game-input.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tilt": {
      "react-native": "./src/tilt/index.ts",
      "types": "./dist/tilt/index.d.ts",
      "import": "./dist/tilt/index.mjs",
      "require": "./dist/tilt/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__mocks__"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm test && npm run typecheck && npm run build",
    "preversion": "npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.2.1",
    "@infinitetoken/jest-config": "^0.5.2",
    "@infinitetoken/tsconfig": "^0.7.0",
    "@tastic/core": "^0.17.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@tastic/core": ">=0.10.0",
    "react": ">=19.0.0",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
